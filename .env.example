# Copy to .env and adjust. NEVER commit .env.
ENV=dev
SECRET_KEY=change-me-generate-a-long-random-string

# TimescaleDB
POSTGRES_USER=study
POSTGRES_PASSWORD=study_dev
POSTGRES_DB=study
DATABASE_URL=postgresql+asyncpg://study:study_dev@timescaledb:5432/study

# Redis (cache, pub/sub, Celery broker)
REDIS_URL=redis://redis:6379/0

# Engine service
ENGINE_URL=http://engine:9000

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Google OAuth (Phase 1 — create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
