{
  "uid": "the-study-main",
  "title": "The Study — Product & Infra",
  "tags": ["the-study"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 / p95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Moves played (telemetry → TimescaleDB)",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('5 minutes', time) AS time, count(*) AS moves FROM move_events WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Engine call latency by kind (ms)",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, request_kind AS metric, avg(latency_ms) AS latency FROM engine_samples WHERE $__timeFilter(time) GROUP BY 1, request_kind ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active players (24h)",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT user_id) AS \"active\" FROM activity_events WHERE time > now() - interval '24 hours'"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "XP awarded (24h)",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(amount),0) AS \"xp\" FROM xp_events WHERE time > now() - interval '24 hours'"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rating changes (all modes)",
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('10 minutes', time) AS time, mode AS metric, count(*) AS changes FROM rating_history WHERE $__timeFilter(time) GROUP BY 1, mode ORDER BY 1"
        }
      ]
    }
  ]
}
